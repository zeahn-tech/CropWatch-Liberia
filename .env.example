# JWT_SECRET: Secret key used to sign and verify session JWT tokens.
JWT_SECRET=

# GEMINI_API_KEY: Required for Gemini AI API calls. AI Studio injects this from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted. AI Studio injects this.
APP_URL="MY_APP_URL"

# S3 OBJECT STORAGE CONFIGURATION (S3-compatible):
# S3_BUCKET_NAME: The name of the S3 bucket to store image uploads.
S3_BUCKET_NAME=
# S3_REGION: The region of the S3 bucket.
S3_REGION=
# S3_ACCESS_KEY_ID: The access key ID for the S3 bucket.
S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY: The secret access key for the S3 bucket.
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT: The endpoint URL for the S3-compatible service.
S3_ENDPOINT=

# WEATHER_API_KEY: Optional OpenWeatherMap API key. If unset, weather data
# comes from the free Open-Meteo API (no key required) instead.
WEATHER_API_KEY=

# DAILY_AI_ANALYSES_LIMIT: Configures the maximum number of Gemini AI crop analyses a farmer can perform per 24 hours.
DAILY_AI_ANALYSES_LIMIT=5

# SUPABASE CONFIGURATION (optional — enables Supabase Auth as an alternative
# to local JWT auth, and best-effort syncing of records to Supabase tables).
# Without these set, the app runs entirely on local JWT auth; nothing breaks.
# SUPABASE_URL / SUPABASE_ANON_KEY: used by the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: used by the frontend build
# (must be prefixed with VITE_ so Vite exposes them to client-side code).
# Set these to the same values as SUPABASE_URL / SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


